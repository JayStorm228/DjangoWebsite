# Скопируйте в .env и поменяйте значения. Файл .env в Git не попадает.

# Секретный ключ Django: сгенерируйте свой, например
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-dev-only-change-me

# 1 — режим разработки, 0 — продакшен
DJANGO_DEBUG=1

# Список хостов через запятую. В разработке можно оставить *
DJANGO_ALLOWED_HOSTS=*

# Домены, с которых разрешены POST-запросы (через запятую, со схемой)
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.e2b.app

# Куда отправлять письма: console (в консоль) или smtp
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
